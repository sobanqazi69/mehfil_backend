# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/mehfil_db"

# Redis (Upstash)
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="different-super-secret-refresh-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# LiveKit (shared server at 187.124.213.14)
# Room names are prefixed "mehfil_room_" to stay isolated from other apps (e.g. Bazmi)
LIVEKIT_URL="wss://187.124.213.14"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Test logins for POST /auth/review-login (email+password instead of Google).
# The store-reviewer account. Leave both unset and the route 404s.
REVIEW_EMAIL="reviewer@example.com"
REVIEW_PASSWORD="change-me"
# Extra testers, comma-separated "email:password". Optional.
REVIEW_ACCOUNTS="tester@example.com:change-me"

# Admin panel sign-in (POST /admin/login). Unset → 503.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Comma-separated origins allowed to call the admin API.
ADMIN_URL="https://admin.example.com,http://localhost:3001"

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL="http://localhost:3001"
